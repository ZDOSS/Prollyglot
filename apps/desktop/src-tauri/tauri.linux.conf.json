{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "python3 ../../scripts/prepare-ubuntu-bundle.py"
  },
  "bundle": {
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local subtitles for desktop audio",
    "longDescription": "Prollyglot turns desktop audio into local live subtitles with a customizable overlay and optional local translation. The experimental Ubuntu build captures one selected playback output; speech and translation models are installed explicitly in the app.",
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.43)", "libpipewire-0.3-0 (>= 1.0)", "pipewire", "wireplumber"],
        "files": {
          "/usr/lib/prollyglot": "../../../target/ubuntu-runtime",
          "/usr/share/doc/prollyglot/LICENSE": "../../../LICENSE",
          "/usr/share/doc/prollyglot/licenses": "../../../docs/licenses"
        }
      }
    }
  }
}
