{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prollyglot",
  "identifier": "com.prollyglot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost prollyglot-model: http://prollyglot-model.localhost https://huggingface.co https://*.hf.co"
    },
    "windows": [
      {
        "label": "main",
        "title": "Prollyglot",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "appearance",
        "title": "Appearance — Prollyglot",
        "url": "appearance.html",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Prollyglot captions",
        "url": "overlay.html",
        "width": 780,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "visual-overlay",
        "title": "Prollyglot visual translation",
        "url": "visual-overlay.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "region-selector",
        "title": "Select a region — Prollyglot",
        "url": "region-selector.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
